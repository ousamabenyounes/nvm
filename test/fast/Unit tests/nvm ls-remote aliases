#!/bin/sh

WORK="${PWD}/nvm-ls-remote-aliases-work.$$"
export HOME="${WORK}/home"
export NVM_DIR="${HOME}/.nvm"

cleanup() {
  command rm -rf "${WORK}"
  unset -f cleanup die nvm_has_colors nvm_remote_versions
}
die () { echo "$@" ; cleanup ; exit 1; }

command mkdir -p "${NVM_DIR}/alias"

: nvm.sh
\. ../../../nvm.sh

nvm_has_colors() { return 1; }
nvm_remote_versions() {
  if [ -n "${NVM_LTS-}" ] || [ -n "${1-}" ]; then
    command printf '%s\n' 'v2.0.0'
  else
    command printf '%s\n' 'v1.0.0 Argon' 'v2.0.0 Iron *'
  fi
  return "${NVM_REMOTE_STATUS-0}"
}

PROJECT_ALIAS='project'
HIDDEN_PROJECT_ALIAS='.project'
LATEST_PROJECT_ALIAS='latest-project'
INVALID_PATTERN_ALIAS='invalid-pattern'
INVALID_PATTERN_TARGET='['
CONTROL_ALIAS="$(command printf 'control\rname')"
nvm_make_alias "${PROJECT_ALIAS}" '1' >/dev/null
nvm_make_alias "${HIDDEN_PROJECT_ALIAS}" '1' >/dev/null
nvm_make_alias "${LATEST_PROJECT_ALIAS}" 'node' >/dev/null
command printf '%s\n' "${INVALID_PATTERN_TARGET}" > "${NVM_DIR}/alias/${INVALID_PATTERN_ALIAS}"
command printf '%s\n' '1' > "${NVM_DIR}/alias/${CONTROL_ALIAS}"

INHERITED_ALIAS='injected'
REMOTE_ERROR="${WORK}/remote-error"
EXPECTED_OLD_OUTPUT='v1.0.0   (LTS: Argon)   (Aliases: .project, project)'
EXPECTED_OUTPUT='v2.0.0   (Latest LTS: Iron)   (Latest: node)   (Aliases: latest-project)'
REMOTE_OUTPUT="$(NVM_REMOTE_ALIASES="${INHERITED_ALIAS}" nvm ls-remote --no-colors 2>"${REMOTE_ERROR}")"
OLD_OUTPUT="$(command printf '%s\n' "${REMOTE_OUTPUT}" | command head -1 | command sed 's/^[[:space:]]*//')"
OUTPUT="$(command printf '%s\n' "${REMOTE_OUTPUT}" | command tail -1 | command sed 's/^[[:space:]]*//')"

[ ! -s "${REMOTE_ERROR}" ] \
  || die "bare nvm ls-remote emitted an error for an invalid alias target; got >$(command cat "${REMOTE_ERROR}")<"
[ "_${OLD_OUTPUT}" = "_${EXPECTED_OLD_OUTPUT}" ] \
  || die "bare nvm ls-remote did not safely annotate a named alias; got >${OLD_OUTPUT}< expected >${EXPECTED_OLD_OUTPUT}<"
[ "_${OUTPUT}" = "_${EXPECTED_OUTPUT}" ] \
  || die "bare nvm ls-remote did not annotate node and a named alias on the latest LTS version; got >${OUTPUT}< expected >${EXPECTED_OUTPUT}<"

case "${REMOTE_OUTPUT}" in
  *unstable*) die "bare nvm ls-remote included the outdated unstable alias; got >${REMOTE_OUTPUT}<" ;;
esac
case "${REMOTE_OUTPUT}" in
  *stable*) die "bare nvm ls-remote included the outdated stable alias; got >${REMOTE_OUTPUT}<" ;;
esac

EXPECTED_FILTERED_OUTPUT='v2.0.0'
OUTPUT="$(NVM_REMOTE_ALIASES="${INHERITED_ALIAS}" nvm ls-remote 2 --no-colors | command tail -1 | command sed 's/^[[:space:]]*//')"

[ "_${OUTPUT}" = "_${EXPECTED_FILTERED_OUTPUT}" ] \
  || die "filtered nvm ls-remote used an inherited remote alias; got >${OUTPUT}< expected >${EXPECTED_FILTERED_OUTPUT}<"

OUTPUT="$(NVM_REMOTE_ALIASES="${INHERITED_ALIAS}" nvm ls-remote --lts --no-colors | command tail -1 | command sed 's/^[[:space:]]*//')"

[ "_${OUTPUT}" = "_${EXPECTED_FILTERED_OUTPUT}" ] \
  || die "LTS nvm ls-remote used an inherited remote alias; got >${OUTPUT}< expected >${EXPECTED_FILTERED_OUTPUT}<"

NVM_REMOTE_STATUS=1
OUTPUT="$(NVM_REMOTE_ALIASES="${INHERITED_ALIAS}" nvm ls-remote --no-colors 2>/dev/null)"
COMMAND_STATUS=$?
NVM_REMOTE_STATUS=0
OUTPUT="$(command printf '%s\n' "${OUTPUT}" | command tail -1 | command sed 's/^[[:space:]]*//')"
EXPECTED_FAILED_OUTPUT='v2.0.0   (Latest LTS: Iron)'

[ "${COMMAND_STATUS}" -eq 1 ] \
  || die "failed nvm ls-remote returned ${COMMAND_STATUS}; expected 1"
[ "_${OUTPUT}" = "_${EXPECTED_FAILED_OUTPUT}" ] \
  || die "failed nvm ls-remote used an inherited remote alias; got >${OUTPUT}< expected >${EXPECTED_FAILED_OUTPUT}<"

nvm_has_colors() { return 0; }

EXPECTED_OUTPUT="$(command printf 'v2.0.0  \033[1;32m (Latest LTS: Iron)\033[0m  \033[1;32m (Latest: node)\033[0m  \033[1;32m (Aliases: latest-project)\033[0m')"
OUTPUT="$(nvm ls-remote | command tail -1 | command sed 's/^[[:space:]]*//')"

[ "_${OUTPUT}" = "_${EXPECTED_OUTPUT}" ] \
  || die "bare nvm ls-remote did not align colored alias annotations; got >${OUTPUT}< expected >${EXPECTED_OUTPUT}<"

cleanup
